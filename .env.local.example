# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit it.

# From Supabase dashboard: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Her WhatsApp number: country code first, digits only.
# No +, no spaces, no leading 0. Nigeria is 234, so 0803 123 4567 becomes 2348031234567
NEXT_PUBLIC_WHATSAPP_NUMBER=2348031234567

# Public address of the site, used to build the product link inside the WhatsApp
# message. Optional: leave it unset locally (falls back to localhost:3000) and on
# Vercel (falls back to the Vercel production domain). Set it only once you have
# a custom domain, with no trailing slash: https://olayinkaboja.com
# NEXT_PUBLIC_SITE_URL=

# Shown in the storefront footer. Optional.
NEXT_PUBLIC_STORE_LOCATION=Balogun Market, Lagos Island
